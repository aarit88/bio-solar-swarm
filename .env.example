# GEMINI_API_KEY: Required for Gemini AI API calls (chat, grounding, Live API).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Provisioned Google Maps Platform API key for geospatial map and Air Quality API.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
